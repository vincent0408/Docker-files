# Local fix for the v1.10.4 KVM sandbox-runner image.
#
# The guest loads its native pipe addon from $SANDBOX_PIPE_ADDON and falls
# back to /sandbox_api/.build/anonymous-pipes.node. The variable is only a
# Dockerfile ENV of the stage the guest rootfs is built from, so it does not
# exist inside the MicroVM, and the launcher's guest env allowlist does not
# forward it. Every execution then fails with
# "Failed to spawn nsjail: Cannot find module ...anonymous-pipes.node".
#
# This adds a symlink at the fallback path inside the guest rootfs image.
# Built by README step B5b and used through docker-compose.kvm-fix.yml.
# Drop both once upstream ships a fix. Details: KVM-RUNNER-PATCH.md.

ARG RUNNER_IMAGE=ghcr.io/librechat-ai/code-interpreter-sandbox-runner:sha-a62d69e05a4541ac9a20722ac7ff3fcfecb6ed24

FROM ${RUNNER_IMAGE} AS runner

FROM debian:bookworm-slim AS patch
RUN apt-get update && apt-get install -y --no-install-recommends e2fsprogs \
    && rm -rf /var/lib/apt/lists/*
COPY --from=runner /sandbox-rootfs.img /sandbox-rootfs.img
RUN chmod u+w /sandbox-rootfs.img \
    && debugfs -R "stat /usr/local/lib/anonymous-pipes.node" /sandbox-rootfs.img | grep -q "Type: regular" \
    && debugfs -w -R "symlink /sandbox_api/.build/anonymous-pipes.node /usr/local/lib/anonymous-pipes.node" /sandbox-rootfs.img \
    && debugfs -R "stat /sandbox_api/.build/anonymous-pipes.node" /sandbox-rootfs.img | grep -q "Type: symlink" \
    && e2fsck -fn /sandbox-rootfs.img \
    && chmod 444 /sandbox-rootfs.img

FROM runner
COPY --from=patch /sandbox-rootfs.img /sandbox-rootfs.img
